# 复制为 .env 后填写；真实环境变量优先级高于 .env

# ---------- QQ 机器人（QQ 开放平台 -> 开发设置） ----------
QQ_APP_ID=
QQ_CLIENT_SECRET=

# 获取 AccessToken 的地址（官方文档：https://api.bot.qq.com/app/getAppAccessToken）
QQ_TOKEN_URL=https://api.bot.qq.com/app/getAppAccessToken

# OpenAPI / 网关地址。正式环境：https://api.sgroup.qq.com
# 沙箱环境：https://sandbox.api.sgroup.qq.com
QQ_API_BASE=https://api.sgroup.qq.com

# 事件订阅位。1<<25 = 33554432（QQ 群 @ 机器人 + 单聊消息）
# 如需频道 @ 消息，可再按位或上 1<<30 = 1073741824
QQ_INTENTS=33554432

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 思考模式：enabled / disabled；默认开启，强度 low
# 官方兼容行为：low、medium 会被映射为 high，max 为最高强度
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=low
# 思考模式下 temperature 不生效
DEEPSEEK_TEMPERATURE=0.8
DEEPSEEK_MAX_TOKENS=1024
# 工具调用单次输出上限。写长文件时参数容易超限被截断，建议保持 4096
DEEPSEEK_TOOL_MAX_TOKENS=4096

# ---------- 对话上下文 ----------
# 每个会话（单聊用户 / 群）最多保留的轮数（一问一答算 1 轮）
CONTEXT_MAX_TURNS=10
# 上下文文件目录（默认 data/contexts）
# CONTEXT_DIR=

# ---------- 私聊独立空间 ----------
# 每个单聊用户独立的文件空间，可读写文本文件
# WORKSPACE_DIR=
WORKSPACE_QUOTA_MB=50
# 命令沙箱模式：auto（有 bwrap 就用）/ bwrap（强制）/ plain（仅受限执行）
SANDBOX_MODE=auto
# 沙箱命令是否可访问外网，默认开启；off 时用独立网络命名空间断网
SANDBOX_NETWORK=on

# ---------- 积分额度 ----------
# 计费：1 积分 = 1 输出 token；1 积分 = 4 输入 token；10 积分 = 1MB 发送文件
# 不满一个单位按一个单位计（各维度分别向上取整）
# 用户/群限额（自然日、自然周、自然月）
QUOTA_USER_DAILY=8000
QUOTA_USER_WEEKLY=32000
QUOTA_USER_MONTHLY=80000
# 全站限额（所有用户与群合计）
QUOTA_GLOBAL_DAILY=50000
QUOTA_GLOBAL_WEEKLY=300000
QUOTA_GLOBAL_MONTHLY=1000000
QUOTA_INPUT_TOKENS_PER_CREDIT=4
QUOTA_CREDITS_PER_MB=10
# 额度账户文件（默认 data/quotas.json）
# QUOTA_FILE=
# 会话偏好文件（默认 data/settings.json，保存 /thinking 设置）
# SETTINGS_FILE=
# 重置码库存文件（默认 data/reset_codes.json，由 scripts/gen_reset_codes.py 生成）
# RESET_CODE_FILE=
# 管理员名单文件（默认 data/admins.json，由 scripts/manage_admins.py 管理）
# 名单内用户不限额度、不计费
# ADMIN_FILE=

# ---------- 网页搜索 / 抓取 ----------
# 必应搜索结果条数（1-10）
WEB_SEARCH_COUNT=5
# 抓取超时秒数、正文最大字符数、响应体大小上限（MB）
WEB_FETCH_TIMEOUT=20
WEB_FETCH_MAX_CHARS=6000
WEB_FETCH_MAX_MB=2
# auto：装了 Playwright 就先渲染页面等 JS 加载完成，否则用 curl；
# curl：只用 curl 抓原始 HTML
# 启用浏览器渲染：pip install playwright && playwright install chromium
WEB_RENDER_MODE=auto

# ---------- 图片输入 ----------
# 每条消息最多下载几张图片、单张大小上限（MB）
IMAGE_MAX_COUNT=4
IMAGE_MAX_MB=5

# ---------- 文档输入 ----------
# 支持 txt/md/csv/json/log/pdf/docx/xlsx/pptx
# 每条消息最多处理几个文档、单个文档大小上限（MB）、提取文本总字符上限
DOCUMENT_MAX_COUNT=3
DOCUMENT_MAX_MB=10
DOCUMENT_MAX_CHARS=8000

# ---------- 消息与日志 ----------
# 群聊单条消息最大字符数，超出自动分条发送（同一 msg_id 最多 5 条）
# 单聊走流式消息，内容上限固定为 2000 字符
MAX_REPLY_CHARS=500
LOG_LEVEL=INFO
