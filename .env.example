# 复制为 .env 后填写；真实环境变量优先级高于 .env

# ---------- QQ 机器人（QQ 开放平台 -> 开发设置） ----------
QQ_APP_ID=
QQ_CLIENT_SECRET=

# 获取 AccessToken 的地址（官方文档：https://api.bot.qq.com/app/getAppAccessToken）
QQ_TOKEN_URL=https://api.bot.qq.com/app/getAppAccessToken

# OpenAPI / 网关地址。正式环境：https://api.sgroup.qq.com
# 沙箱环境：https://sandbox.api.sgroup.qq.com
QQ_API_BASE=https://api.sgroup.qq.com

# 事件订阅位。1<<25 = 33554432（QQ 群 @ 机器人 + 单聊消息）
# 如需频道 @ 消息，可再按位或上 1<<30 = 1073741824
QQ_INTENTS=33554432

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 思考模式：enabled / disabled；默认开启，强度 low
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=low
# 思考模式下 temperature 不生效
DEEPSEEK_TEMPERATURE=0.8
DEEPSEEK_MAX_TOKENS=1024
# 工具调用单次输出上限。写长文件时参数容易超限被截断，建议保持 4096
DEEPSEEK_TOOL_MAX_TOKENS=4096
# 自定义系统提示词；留空使用内置默认提示词
SYSTEM_PROMPT=

# ---------- 对话上下文 ----------
# 旧版按轮数裁剪的兼容配置；现在按下方 token 预算裁剪
CONTEXT_MAX_TURNS=10
# 普通用户上下文 token 预算（不超过 ADMIN_CONTEXT_TOKENS，可用 /context 调整）
CONTEXT_MAX_TOKENS=32000
# 上下文文件目录（默认 data/contexts）
# CONTEXT_DIR=

# ---------- 私聊独立空间 ----------
# 每个单聊用户独立的文件空间，可读写文本文件
# WORKSPACE_DIR=
WORKSPACE_QUOTA_MB=50
# 管理员私有空间上限（MB）
WORKSPACE_ADMIN_QUOTA_MB=1024
# 命令沙箱模式：auto（有 bwrap 就用）/ bwrap（强制）/ plain（仅受限执行）
SANDBOX_MODE=auto
# 沙箱命令是否可访问外网，默认开启；off 时用独立网络命名空间断网
SANDBOX_NETWORK=on
# 单任务 CPU 配额（百分比，10 = 0.1 核）与内存上限（MB）
SANDBOX_CPU_PERCENT=10
SANDBOX_MEMORY_MB=256
# 全局上限：CPU 百分比（50 = 0.5 核）与内存（MB）
SANDBOX_TOTAL_CPU_PERCENT=50
SANDBOX_TOTAL_MEMORY_MB=512
# 并发数上限；0 = 自动（按总量与单任务下限推导，运行中均分资源）
SANDBOX_MAX_PARALLEL=0
# 自动清理超过 N 天未读取/写入的文件（管理员空间不清理）
WORKSPACE_CLEANUP_DAYS=30

# ---------- 积分额度 ----------
# 计费：1 积分 = 1 输出 token；1 积分 = 4 输入 token；10 积分 = 1MB 发送文件
# 沙箱：100 积分/秒；流量 1 积分/1MB（双向）
# 不满一个单位按一个单位计（各维度分别向上取整）
# 用户/群限额（自然日、自然周、自然月）
QUOTA_USER_DAILY=80000
QUOTA_USER_WEEKLY=320000
QUOTA_USER_MONTHLY=800000
# 全站限额（所有用户与群合计）
QUOTA_GLOBAL_DAILY=500000
QUOTA_GLOBAL_WEEKLY=3000000
QUOTA_GLOBAL_MONTHLY=10000000
QUOTA_INPUT_TOKENS_PER_CREDIT=4
QUOTA_CREDITS_PER_MB=10
QUOTA_CREDITS_PER_SECOND=100
QUOTA_CREDITS_PER_MB_NET=1
# 额度账户文件（默认 data/quotas.json）
# QUOTA_FILE=
# 会话偏好文件（默认 data/settings.json，保存 /thinking 设置）
# SETTINGS_FILE=
# 重置码库存文件（默认 data/reset_codes.json，由 scripts/gen_reset_codes.py 生成）
# RESET_CODE_FILE=
# 管理员名单文件（默认 data/admins.json，由 scripts/manage_admins.py 管理）
# 名单内用户不限额度、不计费，工具轮数不限
# ADMIN_FILE=
# 黑名单文件（默认 data/blocked.json）
# BLOCK_FILE=
# 管理员单次输出上限与上下文 token 预算（普通用户受 DEEPSEEK_MAX_TOKENS / CONTEXT_MAX_TURNS 限制）
ADMIN_MAX_TOKENS=393216
ADMIN_CONTEXT_TOKENS=1048576

# ---------- 网页搜索 / 抓取 ----------
# 必应搜索结果条数（1-10）
WEB_SEARCH_COUNT=5
# 抓取超时秒数、正文最大字符数、响应体大小上限（MB）
WEB_FETCH_TIMEOUT=20
WEB_FETCH_MAX_CHARS=6000
WEB_FETCH_MAX_MB=2
# auto：装了 Playwright 就先渲染页面等 JS 加载完成，否则用 curl；
# curl：只用 curl 抓原始 HTML
# 启用浏览器渲染：pip install playwright && playwright install chromium
WEB_RENDER_MODE=auto

# ---------- 图片输入 ----------
# 每条消息最多下载几张图片、单张大小上限（MB）
IMAGE_MAX_COUNT=4
IMAGE_MAX_MB=5

# ---------- 图片生成（AI 工具） ----------
# 开启后 AI 可按用户要求画图，一次调用固定扣除 IMAGE_GEN_CREDITS 积分（管理员免费）
# 需要 OpenAI 兼容的 /images/generations 接口，与对话模型接口可以不同
IMAGE_GEN_ENABLED=off
# 留空时复用 DEEPSEEK_BASE_URL / DEEPSEEK_API_KEY
IMAGE_GEN_BASE_URL=
IMAGE_GEN_API_KEY=
# 模型清单：「模型ID|难度说明」用分号分隔，按画质/成本从低到高排列
# 模型名只给 AI 参考，禁止在回复中向用户透露，也不允许用户指定模型
IMAGE_GEN_MODELS=flux.1-schnell|简单快速：草图、简笔画、简单插画;flux.1-dev|日常均衡：常见写实与插画;gpt-image-1|高质量：复杂构图、精细细节、画面内文字
# 可选尺寸，AI 按构图需要选择
IMAGE_GEN_SIZES=1024x1024,1024x1792,1792x1024
# 单次生成超时（秒）、固定积分、下载图片大小上限（MB）
IMAGE_GEN_TIMEOUT=180
IMAGE_GEN_CREDITS=2000
IMAGE_GEN_MAX_MB=20

# ---------- 文档输入 ----------
# 支持 txt/md/csv/json/log/pdf/docx/xlsx/pptx
# 每条消息最多处理几个文档、单个文档大小上限（MB）、提取文本总字符上限
DOCUMENT_MAX_COUNT=3
DOCUMENT_MAX_MB=10
DOCUMENT_MAX_CHARS=8000

# ---------- 语音输入 ----------
# QQ 官方语音附件带 asr_refer_text（参考文本）与 voice_wav_url（WAV），优先免费用前者
USE_QQ_ASR_REFER=on
# 第三方 Fun-ASR 默认关闭；需要时改为 on 并填写 ASR_API_KEY
ASR_ENABLED=off
# 仅在 ASR_ENABLED=on 且参考文本为空时调用 Fun-ASR 录音文件转写接口
# 也可以直接使用 DASHSCOPE_API_KEY，二者取其一
# 注意：音频地址会上传到该服务商，敏感场景请保持关闭
ASR_BASE_URL=https://maas.qianwenaiapi.com/api/v1
ASR_API_KEY=
# 可选：DashScope 密钥（ASR_API_KEY 为空时使用）
DASHSCOPE_API_KEY=
ASR_MODEL=fun-asr
# 识别语言，留空由模型自动判断
ASR_LANGUAGE=zh
# 异步任务总超时秒数（提交 + 轮询）
ASR_TIMEOUT=60
ASR_MAX_CHARS=2000
# 每条消息最多处理几条语音、单个语音大小上限（MB）
VOICE_MAX_COUNT=2
VOICE_MAX_MB=10

# ---------- 网页人工回复控制台 ----------
# 默认监听所有网卡；管理员在 QQ 里发 /console 获取 30 秒刷新一次的验证码登录
CONSOLE_ENABLED=on
CONSOLE_HOST=0.0.0.0
CONSOLE_PORT=8080
# 登录有效期（小时）
CONSOLE_SESSION_HOURS=12
# 控制台消息与接管状态文件（默认 data/console.json）
# CONSOLE_FILE=
# 每个会话保留的消息条数
CONSOLE_HISTORY=200

# ---------- 消息与日志 ----------
# 群聊单条消息最大字符数，超出自动分条发送（同一 msg_id 最多 5 条）
# 单聊走流式消息，内容上限固定为 2000 字符
MAX_REPLY_CHARS=500
LOG_LEVEL=INFO
# 普通 HTTP 请求超时秒数
REQUEST_TIMEOUT=15
